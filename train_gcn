clear; clc; close all;
rng(42);

dataFolder="/home/kronos/Downloads/GCN_coding/ML_data/ML_data/ideal";

imds = imageDatastore(dataFolder, IncludeSubfolders=true, LabelSource="foldernames");
disp(countEachLabel(imds))

figure;

for k = 0:3
    idx = find(imds.Labels == categorical(string(k)), 1);

    img = readimage(imds, idx);

    subplot(2,2,k+1);
    imshow(img);
    title("Class " + k);
end


N = numel(imds.Files);
y = str2double(string(imds.Labels)); % Labels 0,1,2,3

X = zeros(N, 576);

for i = 1:N
    I = imread(imds.Files{i});

    if isinteger(I)
        I = double(I) / double(intmax(class(I)));
    else
        I = double(I);
    end

    if ndims(I) == 3
        I = 0.2989*I(:,:,1) ...
          + 0.5870*I(:,:,2) ...
          + 0.1140*I(:,:,3);
    end

    I = imresize(I, [24 24]);
    X(i,:) = I(:)';
end

mu = mean(X,1);
sigma = std(X,0,1);
sigma(sigma < 1e-8) = 1;
X = (X-mu)./sigma;



k = 8;

Xnorm = X ./ max(sqrt(sum(X.^2,2)), 1e-12);
S = Xnorm * Xnorm';

S(1:N+1:end) = -Inf;

A = sparse(N,N);

for i = 1:N
    [~,idx] = sort(S(i,:), 'descend');
    A(i,idx(1:k)) = 1;
end

A = spones(A + A');
A = A + speye(N);

d = sum(A,2);
D = spdiags(1./sqrt(d),0,N,N);
Ahat = D*A*D;

trainMask = false(N,1);
testMask = false(N,1);

for c = 0:3
    idx = find(y == c);
    idx = idx(randperm(numel(idx)));

    nTrain = floor(0.8*numel(idx));

    trainMask(idx(1:nTrain)) = true;
    testMask(idx(nTrain+1:end)) = true;
end

Y = zeros(N,4);
Y(sub2ind(size(Y),(1:N)',y+1)) = 1;

W1 = randn(576,64)*sqrt(2/640);
W2 = randn(64,4)*sqrt(2/68);

%% Train GCN

numEpochs = 300;
learnRate = 0.01;
weightDecay = 1e-4;

beta1 = 0.9;
beta2 = 0.999;
epsilon = 1e-8;

mW1 = zeros(size(W1));
vW1 = zeros(size(W1));
mW2 = zeros(size(W2));
vW2 = zeros(size(W2));

numTrain = sum(trainMask);
lossHistory = zeros(numEpochs,1);

for epoch = 1:numEpochs

    % Forward pass
    Z1 = Ahat * (X * W1);
    H = max(Z1,0);
    Z2 = Ahat * (H * W2);

    % Softmax
    Z2 = Z2 - max(Z2,[],2);
    expZ = exp(Z2);
    P = expZ ./ sum(expZ,2);

    % Training loss
    Ptrain = P(trainMask,:);
    Ytrain = Y(trainMask,:);

    loss = -sum(sum(Ytrain .* log(Ptrain + 1e-12))) / numTrain;
    lossHistory(epoch) = loss;

    % Backpropagation
    dZ2 = zeros(N,4);
    dZ2(trainMask,:) = (Ptrain-Ytrain)/numTrain;

    dW2 = H' * (Ahat' * dZ2) + weightDecay*W2;

    dH = Ahat' * dZ2 * W2';
    dZ1 = dH .* (Z1 > 0);

    dW1 = X' * (Ahat' * dZ1) + weightDecay*W1;

    % Adam update: W1
    mW1 = beta1*mW1 + (1-beta1)*dW1;
    vW1 = beta2*vW1 + (1-beta2)*dW1.^2;

    m1hat = mW1/(1-beta1^epoch);
    v1hat = vW1/(1-beta2^epoch);

    W1 = W1 - learnRate*m1hat./(sqrt(v1hat)+epsilon);

    % Adam update: W2
    mW2 = beta1*mW2 + (1-beta1)*dW2;
    vW2 = beta2*vW2 + (1-beta2)*dW2.^2;

    m2hat = mW2/(1-beta1^epoch);
    v2hat = vW2/(1-beta2^epoch);

    W2 = W2 - learnRate*m2hat./(sqrt(v2hat)+epsilon);

    if mod(epoch,10)==0
        fprintf('Epoch %d/%d | Loss: %.4f\n', ...
            epoch,numEpochs,loss);
    end
end

figure;
plot(lossHistory,'LineWidth',1.5);
xlabel('Epoch');
ylabel('Training Loss');
title('GCN Training Loss');
grid on;

%% Evaluate GCN

Z1 = Ahat * (X * W1);
H = max(Z1,0);
Z2 = Ahat * (H * W2);

Z2 = Z2 - max(Z2,[],2);
P = exp(Z2);
P = P ./ sum(P,2);

%% Correct evaluation

[~, predictedClass] = max(P, [], 2);

% Compare predictions and labels using the same encoding.
actual = y(testMask);
predicted = predictedClass(testMask) - 1;

accuracy = mean(predicted == actual);

fprintf('Test Accuracy: %.2f%%\n', accuracy * 100);

C = confusionmat(actual, predicted, 'Order', 0:3);
disp(C);


figure;
imagesc(C);
colorbar;
axis square;
xticks(1:4);
yticks(1:4);
xticklabels({'0','1','2','3'});
yticklabels({'0','1','2','3'});
xlabel('Predicted Class');
ylabel('Actual Class');
title(sprintf('Test Accuracy: %.2f%%',accuracy*100));

disp('Predicted test-class counts:');
tabulate(predicted);

fprintf('Loss first 10 epochs:\n');
disp(lossHistory(1:10));

fprintf('W1 range: %.4f to %.4f\n', min(W1(:)), max(W1(:)));
fprintf('W2 range: %.4f to %.4f\n', min(W2(:)), max(W2(:)));

fprintf('Feature range: %.4f to %.4f\n', min(X(:)), max(X(:)));
fprintf('NaNs in W1: %d\n', sum(isnan(W1(:))));
fprintf('NaNs in W2: %d\n', sum(isnan(W2(:))));

fprintf('Training labels:\n');
tabulate(y(trainMask));

% Check training and test accuracy separately

trainAccuracy = mean(predictedClass(trainMask) == y(trainMask) + 1);
testAccuracy  = mean(predictedClass(testMask) == y(testMask) + 1);

fprintf('Training accuracy: %.2f%%\n', trainAccuracy * 100);
fprintf('Test accuracy: %.2f%%\n', testAccuracy * 100);

% Check predicted probabilities
fprintf('Minimum probability: %.8f\n', min(P(:)));
fprintf('Maximum probability: %.8f\n', max(P(:)));
