%% GCN Image Classification with Deep Learning Toolbox
% MATLAB R2025b
% Four classes: 0, 1, 2, 3
% Each image is a node in the graph.

clear;
clc;
close all;

rng(42);

%% 1. Load dataset

dataFolder = "/home/kronos/Downloads/GCN_coding/ML_data/ML_data/ideal";

imds = imageDatastore(dataFolder, ...
    IncludeSubfolders=true, ...
    LabelSource="foldernames");

disp(countEachLabel(imds));

N = numel(imds.Files);

% Original labels: 0, 1, 2, 3
y = str2double(string(imds.Labels));

assert(N > 0, 'No images found.');
assert(all(ismember(y,0:3)), ...
    'Expected folder labels 0, 1, 2, and 3.');

fprintf('Total images: %d\n',N);

%% 2. Extract image features

% Resize each RGB spectrogram to 24 x 24 grayscale.
% Each image becomes a 576-dimensional feature vector.

imageSize = 24;
numFeatures = imageSize^2;

X = zeros(N,numFeatures);

fprintf('Extracting image features...\n');

for i = 1:N

    I = imread(imds.Files{i});

    if isinteger(I)
        I = double(I)/double(intmax(class(I)));
    else
        I = double(I);
    end

    if ndims(I) == 3
        I = 0.2989*I(:,:,1) ...
          + 0.5870*I(:,:,2) ...
          + 0.1140*I(:,:,3);
    end

    I = imresize(I,[imageSize imageSize]);

    X(i,:) = I(:)';

end

% Standardize each feature.
mu = mean(X,1);
sigma = std(X,0,1);
sigma(sigma < 1e-8) = 1;

X = (X-mu)./sigma;

fprintf('Feature matrix: %d x %d\n',size(X,1),size(X,2));

%% 3. Split into training and test sets

% Stratified 80/20 split.
% Each class contributes approximately the same proportion.

trainMask = false(N,1);
testMask = false(N,1);

for c = 0:3

    idx = find(y == c);
    idx = idx(randperm(numel(idx)));

    nTrain = floor(0.8*numel(idx));

    trainMask(idx(1:nTrain)) = true;
    testMask(idx(nTrain+1:end)) = true;

end

fprintf('Training images: %d\n',sum(trainMask));
fprintf('Test images: %d\n',sum(testMask));

% One-hot labels: rows are classes, columns are images.
Y = zeros(4,N);

for i = 1:N
    Y(y(i)+1,i) = 1;
end

%% 4. Construct the graph using training images only

% Build the graph from training data.
% Test images are connected to training nodes at inference time.

k = 8;

Xtrain = X(trainMask,:);

nTrain = size(Xtrain,1);

% Normalize feature vectors for cosine similarity.
rowNorm = sqrt(sum(Xtrain.^2,2));
rowNorm(rowNorm < 1e-12) = 1;

XtrainNorm = Xtrain./rowNorm;

S = XtrainNorm*XtrainNorm';

% Remove self-connections during neighbor selection.
S(1:nTrain+1:end) = -Inf;

Atrain = sparse(nTrain,nTrain);

for i = 1:nTrain

    [~,idx] = sort(S(i,:),'descend');

    neighbors = idx(1:min(k,nTrain-1));

    Atrain(i,neighbors) = 1;

end

% Symmetrize and add self-loops.
Atrain = spones(Atrain + Atrain');
Atrain = Atrain + speye(nTrain);

% Symmetric degree normalization.
d = sum(Atrain,2);

D = spdiags(1./sqrt(d),0,nTrain,nTrain);

AtrainNorm = D*Atrain*D;

fprintf('Training graph constructed: %d nodes\n',nTrain);

%% 5. Connect test images to training nodes

% Each test image connects to its k most similar training images.
% Test images do not connect to one another.

Xtest = X(testMask,:);

nTest = size(Xtest,1);

XtestNorm = Xtest./max(sqrt(sum(Xtest.^2,2)),1e-12);

Stest = XtestNorm*XtrainNorm';

Atest = sparse(nTest,nTrain);

for i = 1:nTest

    [~,idx] = sort(Stest(i,:),'descend');

    neighbors = idx(1:min(k,nTrain));

    Atest(i,neighbors) = 1;

end

% Normalize test-to-training connections using training degrees.
trainDegree = full(sum(Atrain,2));

testDegree = full(sum(Atest,2));

AtrainNorm = spdiags(1./sqrt(trainDegree),0,nTrain,nTrain) ...
    * Atrain ...
    * spdiags(1./sqrt(trainDegree),0,nTrain,nTrain);

AtestNorm = spdiags(1./sqrt(max(testDegree,1)),0,nTest,nTest) ...
    * Atest ...
    * spdiags(1./sqrt(trainDegree),0,nTrain,nTrain);

%% 6. Initialize the GCN

numHidden = 64;
numClasses = 4;

numEpochs = 200;
learnRate = 0.005;
weightDecay = 1e-4;

% Convert matrices to single precision.
dlXtrain = dlarray(single(Xtrain'));
dlAtrain = dlarray(single(full(AtrainNorm)));
dlYtrain = dlarray(single(Y(:,trainMask)));

% Initialize trainable weights.
W1 = dlarray(single(randn(numHidden,numFeatures) ...
    * sqrt(2/(numFeatures+numHidden))));

W2 = dlarray(single(randn(numClasses,numHidden) ...
    * sqrt(2/(numHidden+numClasses))));

% Adam optimizer states.
avgGrad1 = [];
avgSqGrad1 = [];

avgGrad2 = [];
avgSqGrad2 = [];

lossHistory = zeros(numEpochs,1);

%% 7. Train the GCN

fprintf('\nStarting GCN training...\n');

for epoch = 1:numEpochs

    [loss,gradW1,gradW2] = dlfeval( ...
        @gcnModelLoss, ...
        W1,W2,dlXtrain,dlAtrain,dlYtrain,weightDecay);

    [W1,avgGrad1,avgSqGrad1] = adamupdate( ...
        W1,gradW1,avgGrad1,avgSqGrad1,epoch,learnRate);

    [W2,avgGrad2,avgSqGrad2] = adamupdate( ...
        W2,gradW2,avgGrad2,avgSqGrad2,epoch,learnRate);

    lossHistory(epoch) = double(extractdata(loss));

    if mod(epoch,10)==0
        fprintf('Epoch %d/%d | Loss: %.6f\n', ...
            epoch,numEpochs,lossHistory(epoch));
    end

end

fprintf('Training complete.\n');

%% 8. Plot training loss

figure;

plot(lossHistory,'LineWidth',1.5);

xlabel('Epoch');
ylabel('Cross-Entropy Loss');

title('GCN Training Loss');

grid on;

%% 9. Evaluate on held-out test images

% Test-to-training adjacency
dlAtest = dlarray(single(full(AtestNorm)));

% Aggregate training features for each test node
Htest = W1 * dlXtrain * dlAtest';

% ReLU activation
Htest = max(Htest, 0);

% Class scores
Ztest = W2 * Htest;

% Softmax
Ztest = Ztest - max(Ztest, [], 1);
Ptest = exp(Ztest);
Ptest = Ptest ./ sum(Ptest, 1);

% Convert predictions to MATLAB arrays
Ptest = extractdata(Ptest)';

[~, predictedClass] = max(Ptest, [], 2);
predictedLabels = predictedClass - 1;

actualLabels = y(testMask);

accuracy = mean(predictedLabels == actualLabels);

fprintf('\nTest accuracy: %.2f%%\n', accuracy * 100);

%% Confusion matrix

C = confusionmat(actualLabels, predictedLabels, 'Order', 0:3);

disp('Confusion matrix: rows = actual, columns = predicted');
disp(C);

figure;
confusionchart(C, {'0','1','2','3'});
title(sprintf('GCN Test Accuracy: %.2f%%', accuracy * 100));

%% 10. Confusion matrix

C = confusionmat(actualLabels,predictedLabels,'Order',0:3);

disp('Confusion matrix: rows = actual, columns = predicted');
disp(C);

figure;

confusionchart(C,{'0','1','2','3'});

title(sprintf('GCN Test Accuracy: %.2f%%',accuracy*100));

function [loss,gradW1,gradW2] = gcnModelLoss( ...
    W1,W2,X,A,Y,weightDecay)

    % X: 576 x 476
    % A: 476 x 476
    % W1: 64 x 576
    % W2: 4 x 64
    % Y: 4 x 476

    % Graph convolution 1
    H = W1 * X;
    H = H * A';
    H = max(H,0);

    % Graph convolution 2
    Z = W2 * H;
    Z = Z * A';

    % Softmax
    Z = Z - max(Z,[],1);
    P = exp(Z);
    P = P ./ sum(P,1);

    % Cross-entropy
    loss = -mean(sum(Y .* log(P + 1e-7),1));

    % Regularization
    loss = loss + weightDecay * ...
        (sum(W1.^2,'all') + sum(W2.^2,'all'))/2;

    % Automatic differentiation
    [gradW1,gradW2] = dlgradient(loss,W1,W2);
end
